# TO DO List kurulum ayarları.
#
# Bu dosyayı elle kopyalamayın: ./hazirla.sh çalıştırın. Betik bu dosyadan .env
# üretir ve aşağıda boş bırakılan parolaları ve anahtarları rastgele doldurur.
# .env dosyası depoya gönderilmez.

# Uygulamanın tarayıcıdan açılacağı adres (sonunda / olmadan).
WEB_URL=http://localhost:9300
CORS_ALLOWED_ORIGINS=http://localhost:9300

# Vekilin (Caddy) bilgisayarda/sunucuda dinleyeceği portlar.
LISTEN_HTTP_PORT=9300
LISTEN_HTTPS_PORT=9343

# Caddy'nin sertifikayı kendisi alması için: SITE_ADDRESS=todo.sirketiniz.com
# ve CERT_EMAIL="email <adres>". Yerel denemede ya da önde başka bir ters
# vekil varken olduğu gibi bırakın.
SITE_ADDRESS=:80
CERT_EMAIL=
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
CERT_ACME_DNS=
TRUSTED_PROXIES=0.0.0.0/0

# --- hazirla.sh tarafından doldurulur -------------------------------------
POSTGRES_USER=plane
POSTGRES_DB=plane
POSTGRES_PASSWORD=
DATABASE_URL=

RABBITMQ_USER=plane
RABBITMQ_VHOST=plane
RABBITMQ_PASSWORD=
AMQP_URL=

SECRET_KEY=
LIVE_SERVER_SECRET_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# ---------------------------------------------------------------------------

# Dosya ekleri (kurulumla gelen depolama).
USE_MINIO=1
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads
FILE_SIZE_LIMIT=5242880
MINIO_ENDPOINT_SSL=0

DEBUG=0
API_KEY_RATE_LIMIT=60/minute
# İstemci IP'sini doğru okumak için API'nin önündeki ters vekil sayısı: yalnızca
# kurulumdaki vekil varsa 1, önünde bir vekil daha varsa 2. Boş bırakılırsa
# Plane'in varsayılan davranışı geçerlidir.
NUM_PROXIES=
